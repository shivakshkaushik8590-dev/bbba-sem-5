# =====================================================================
# 2 AM TO PM — Haute European Cafe & Salon: Environment Configuration
# =====================================================================

# ---------------------------------------------------------------------
# Supabase Public Configuration (Accessible in Frontend/Browser via Vite)
# ---------------------------------------------------------------------
# Your Supabase Project URL (e.g., https://your-project-id.supabase.co or http://127.0.0.1:54321 for local)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Anonymous Public API Key (safe for browser distribution)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------------------------------------------------------------------
# Supabase Secret Configuration (Server-Side / CLI / Edge Functions ONLY)
# NEVER expose these with VITE_ prefix or in client-side bundles!
# ---------------------------------------------------------------------
# Service Role Secret Key (Bypasses Row Level Security for admin jobs)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Direct PostgreSQL Connection String (for migrations / Prisma / Drizzle / direct psql)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Connection Pooling URL (PgBouncer - port 6543 for serverless / edge runtime)
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true

# ---------------------------------------------------------------------
# Application Configuration
# ---------------------------------------------------------------------
VITE_APP_ENV=development
VITE_APP_NAME="2AM to PM — Haute European Cafe & Salon"
VITE_SITE_URL=http://localhost:3000

